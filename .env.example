# Check My Next Home — secrets shopping list (BLANKS ONLY)
#
# This file lists every machine key from the plan's Keys section (K1–K21)
# that lives in a secret file, with EMPTY values. It is safe to upload:
# it contains no real secrets.
#
# The real values go in a file called .env.local (on a computer) or the
# server's secret file (in production). Those files are on the "never
# upload" list (.gitignore) and must never be uploaded, emailed or pasted
# into chat. Master copies of passwords live in the password manager.
#
# Copy this file to .env.local and fill in only the keys you have reached
# in the plan — most are created much later (the "Created in" milestone
# is noted against each one).

# K5 — Cloudflare "robot-check" keys (Turnstile) — Created in M7
# Public site key (safe to show in the browser):
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key (server only):
TURNSTILE_SECRET_KEY=

# K6 — Database password — Created in M3
# The connection string the app uses to open the fact store;
# it contains the database password:
DATABASE_URL=
# The same settings for the database recipe (docker-compose.yml, step
# M3.1): Docker Compose reads these from .env.local when started with
# --env-file .env.local. The password inside DATABASE_URL above and
# POSTGRES_PASSWORD below must be the same value.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# K7 — Backup keys (Cloudflare R2) — Created in M11
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# K8 — Backup scrambling password — Created in M11
# Used by the backup job on the server. The master copy stays in the
# password manager plus a paper copy at home — without it, backups
# cannot be restored.
BACKUP_ENCRYPTION_PASSWORD=

# K9 — EPC data token (government energy-certificate service) — Created in M4
EPC_API_TOKEN=

# K10 — Bus data key (Bus Open Data Service) — Created in M5
BUS_OPEN_DATA_API_KEY=

# K11 — Email sending key (Resend) — Created in M4.8 (brought forward from M9 for the loader alert)
RESEND_API_KEY=

# K12 / K13 — Payment keys — Created in M9 (live set only at M13)
# K12 is the TEST set and belongs on the play site only.
# K13 is the LIVE set and belongs on the real server only — never the play site.
# (Which payment provider is decided at M9 — plan decision D3.)
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# K14 — Error-alarm key (Sentry) — Created in M11
SENTRY_DSN=

# K15 — Play-site lock — Created in M2
# Implemented as Cloudflare Access (M2.7): the two allowed email
# addresses receive a one-time PIN by email, so there is no shared
# password value to store here. Line kept so the inventory is complete.
PLAY_SITE_PASSWORD=

# Not a secret — a behaviour setting, listed here so it is documented.
# NEXT_PUBLIC_SITE_ENV — the environment name — Set in M2 (step M2.8)
# Controls the "TEST SITE — not the real service" banner. Leave unset or
# set to "play" everywhere except the real server, where M12/M13 sets
# "production" — the only value that hides the banner. It also drives
# the SEO skeleton (M2.11): only "production" gets indexable page
# metadata, a crawlable robots.txt and a sitemap with pages in it;
# every other value keeps the site out of search engines entirely.
NEXT_PUBLIC_SITE_ENV=

# K16 — Report download signing secret — Created in M8
REPORT_SIGNING_SECRET=

# K17 — Open Charge Map API key — Created in M5.7
# The EV chargers loader's credential. On the real server the
# value sits here; in the build sandbox the same key is held
# in the Secure Vault (custom.open-charge-map connector) and
# the loader reaches it through the connector helper instead
# (OCM_HELPER_PATH overrides the helper's location). The key
# itself never appears in the repo, the logs or a fixture.
OPEN_CHARGE_MAP_API_KEY=

# ---------------------------------------------------------------------------
# The remaining Keys-section entries are NOT secret-file values, so they
# have no line above — listed here so this file covers the whole inventory:
#   K1  GitHub password + 2-step login app .... password manager + phone app
#   K2  GitHub recovery codes ................. printed, kept safe at home
#   K3  Server login key (SSH key file) ....... created in M12; laptop +
#                                               password manager backup
#   K4  Cloudflare password + 2-step login .... password manager
#   K18 Domain registrar account + 2-step ..... password manager + master note
#   K19 Social handles (@checkmynexthome) ..... password manager + master note
#   K20 Google Search Console account ......... project Google account
#   K21 Trademark file reference .............. master note + project documents
