# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Binary site assets (M7.1) — materialised from their committed
# .b64 sources by scripts/materialise-binary-assets.mjs on every
# build/dev run; only the .b64 text is ever committed.
/app/favicon.ico
/app/icon.png
/app/apple-icon.png
/public/og-image.png
/public/sample-report/*.png
/e2e/visual.e2e.ts-snapshots/*.png
/public/fonts/*.woff2

# Playwright (M7.1) — run artefacts, never committed
/test-results/
/playwright-report/

# Loader runner fallback record (M4.8) — a local safety net, never committed
loader-runs-fallback.jsonl

# Outside-link robot state (M8.7) — last week's landings, never committed
scripts/outside-link-state.json
